.venv/
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/

# Datasets and weights stay out of git. The HaGRID subset is 384 MB of
# someone else's CC BY-SA data, the landmarker is a Google release, and
# checkpoints are reproducible from the code. The README says how to fetch
# each one.
data/
checkpoints/
models/*.task
*.zip
*.npz

# The one exception: the stand-back punch model ships with the package,
# because it was fitted on footage that is fetched, not committed, so it
# cannot be rebuilt from the repository alone. It is 20 KB.
!ika/weights/*.npz
